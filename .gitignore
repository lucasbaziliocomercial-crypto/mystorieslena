# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Electron build artifacts (instaladores, app empacotado)
# Glob cobre variantes de build (dist-electron-teste, -out, etc.) — sem isso o
# Tailwind v4 varre o app empacotado como "content source" e estoura a memória.
/dist-electron*/
/electron/dist/
/electron/icons/icon.png
/electron/icons/icon.ico
/electron/icons/icon.icns

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (mantém os .example versionados, ignora os reais)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling local
.playwright-mcp/
.claude/

# segundo cérebro Obsidian (knowledge base pessoal — nao versionar)
.obsidian/
/Cerebro/

# artefatos de teste/dev e scratch (sanitizacao 2026-06-03) — nao versionar
/.e2e-*.txt
/e2e-*.png
/e2e-*.json
/PARTE2_ESTRUTURA.txt
/docx_sections.txt
/tmp-*.txt
/tmp-export/

# resultados do golden check do Revisor (gerados por `npm run golden`)
/scripts/golden/results/

# seed de dev (gerado por scripts/build-seed.mjs; pesado, fica fora do git)
# obs: ainda fisicamente em public/ p/ o dev-seed.html funcionar via fetch("/dev-roteiros.json").
# nao-shippar no instalador e build-config separado (ver MAINTENANCE.md P1#3).
/public/dev-roteiros.json
/public/dev-seed.html

# build/release logs
release-build.log
release-publish.log
