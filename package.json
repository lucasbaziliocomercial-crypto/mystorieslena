{
  "name": "mystorieslena",
  "productName": "MyStoriesLena",
  "version": "1.1.9",
  "description": "MyStoriesLena — Gerador de Roteiros de Romance",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/test-parse-markdown-errors.mjs && node scripts/test-build-prompt-input.mjs && node scripts/test-validate-rewrite.mjs && node scripts/test-lz-compress-vendored.mjs && node scripts/test-strip-internal-duplication.mjs && node scripts/test-strip-pov-markers-part1.mjs && node scripts/test-pov-parte1-e2e.mjs && node scripts/test-claude-retry.mjs && node scripts/test-history-sidekey-roundtrip.mjs && node scripts/test-normalize-estrutura-distribution.mjs && node scripts/test-pending-read-overlay.mjs && node scripts/test-narrador-leak-e2e.mjs",
    "revisao": "node scripts/revisao-rigorosa.mjs",
    "golden": "node scripts/golden-eval.mjs",
    "clean": "node -e \"for (const d of ['.next','dist-electron']) { try { require('fs').rmSync(d,{recursive:true,force:true}); console.log('removido:',d) } catch(e) { console.log('skip',d,e.message) } }\"",
    "clean:next": "node -e \"try { require('fs').rmSync('.next',{recursive:true,force:true}); console.log('.next removido') } catch(e) { console.log(e.message) }\"",
    "clean:dist": "node -e \"try { require('fs').rmSync('dist-electron',{recursive:true,force:true}); console.log('dist-electron removido') } catch(e) { console.log(e.message) }\"",
    "electron:dev": "concurrently --kill-others \"npm:dev\" \"wait-on http://localhost:3000 && node scripts/run-electron.mjs --dev\"",
    "electron:start": "node scripts/run-electron.mjs",
    "prepackage": "node scripts/build-icon.js",
    "package": "npm run typecheck && next build && electron-builder",
    "package:win": "npm run typecheck && next build && electron-builder --win nsis",
    "package:mac": "next build && electron-builder --mac dmg zip",
    "package:dir": "next build && electron-builder --dir",
    "prerelease": "npm run clean:dist",
    "release": "npm run typecheck && next build && electron-builder --publish always",
    "prerelease:win": "npm run clean:dist",
    "release:win": "npm run typecheck && next build && electron-builder --win nsis --publish always",
    "release:mac": "next build && electron-builder --mac dmg zip --publish always",
    "release:draft": "next build && electron-builder --publish onTagOrDraft",
    "icon:build": "node scripts/build-icon.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@anthropic-ai/claude-code": "^2.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.11.0",
    "lz-string": "^1.5.0",
    "next": "16.2.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mystorieslena.app",
    "productName": "MyStoriesLena",
    "afterPack": "scripts/mac-adhoc-sign.js",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "!electron/dist/**",
      "!electron/icons/source.svg"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules/@anthropic-ai/**",
          "!public/dev-roteiros.json",
          "!public/dev-seed.html",
          "!dist-electron*/**",
          "!*.png",
          "!*.log"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@anthropic-ai",
        "to": "app/node_modules/@anthropic-ai",
        "filter": [
          "claude-code-*/**/*",
          "claude-agent-sdk-*/**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lucasbaziliocomercial-crypto",
        "repo": "mystorieslena",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico",
      "artifactName": "MyStoriesLena-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyStoriesLena",
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "MyStoriesLena-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "MyStoriesLena ${version}",
      "icon": "electron/icons/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
